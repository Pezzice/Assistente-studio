# Copia in .env.local (in locale) o inserisci su Vercel > Settings > Environment Variables.
# Non committare mai i valori reali.

# Credenziali ClasseViva dello studente (solo lato server)
CLASSEVIVA_USER=
CLASSEVIVA_PASS=

# Indirizzo segreto in formato iCal del calendario "Famiglia"
# (Google Calendar > Impostazioni calendario > Integra calendario)
FAMILY_ICS_URL=

# PIN per aprire l'app (lascia vuoto per disattivarlo in locale)
FAMILY_PIN=
